<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/liquid_bar" />
        </shape>
    </item>
    <!-- 1dp highlight on the top edge only (other edges pushed off-screen) -->
    <item
        android:bottom="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/liquid_stroke" />
        </shape>
    </item>
</layer-list>
