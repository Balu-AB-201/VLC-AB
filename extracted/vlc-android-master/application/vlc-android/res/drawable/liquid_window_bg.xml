<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="@color/liquid_grad_mid"
                android:endColor="@color/liquid_grad_end"
                android:startColor="@color/liquid_grad_start"
                android:type="linear" />
        </shape>
    </item>
    <!-- warm orange blob, top left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.10"
                android:endColor="#00000000"
                android:gradientRadius="75%p"
                android:startColor="@color/liquid_blob_a"
                android:type="radial" />
        </shape>
    </item>
    <!-- cool blue blob, bottom right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.90"
                android:centerY="0.85"
                android:endColor="#00000000"
                android:gradientRadius="80%p"
                android:startColor="@color/liquid_blob_b"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
